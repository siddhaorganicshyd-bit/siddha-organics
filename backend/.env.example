PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# MongoDB Atlas
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/siddha_organics?retryWrites=true&w=majority

# ─── Admin Seeding (creates admin user on first startup if not exists) ────────
ADMIN_NAME=Siddha Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecurePassword123
ADMIN_PHONE=9876543210

# ─── Frontend URL (for CORS in production) ────────────────────────────────────
FRONTEND_URL=https://your-frontend-domain.vercel.app

# ─── Brevo (Sendinblue) Email API ─────────────────────────────────────────────
# Get your API key at: https://app.brevo.com/settings/keys/api
# Leave empty to use dev mode (OTP logged to console)
BREVO_API_KEY=

# ─── Gmail (sender identity for Brevo) ────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Fast2SMS (Indian SMS delivery) ───────────────────────────────────────────
# Get your API key at: https://www.fast2sms.com/dashboard/dev
# Leave empty to use dev mode (OTP logged to console)
FAST2SMS_API_KEY=

# ─── WhatsApp Cloud API (optional OTP delivery) ───────────────────────────────
# Leave empty to use dev mode (OTP logged to console)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Get keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret
